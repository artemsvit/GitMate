{
  "name": "gitler",
  "version": "1.2.0",
  "description": "A local Git client for macOS",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "tsx server/main.ts",
    "server": "NODE_ENV=development tsx server/main.ts",
    "client": "vite",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build:client": "vite build",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=server/index.cjs",
    "build": "node scripts/sync-version.cjs && npm run typecheck && npm run build:client && npm run build:server",
    "build:dmg-assets": "electron scripts/generate-dmg-assets.cjs",
    "dist:mac": "npm run build && npm run build:dmg-assets && GITLER_RELEASE=1 electron-builder --mac dmg zip --arm64 --publish never",
    "dist:dir": "npm run build && electron-builder --mac dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "dev:desktop": "npm run build && electron .",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "dotenv": "^18.0.7",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "node-llama-cpp": "3.22.1",
    "react-markdown": "10.1.0",
    "simple-git": "^4.0.2",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "43.7.9",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": "Artem Svitelskyi",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "simple-git": "^4.0.2"
  }
}
