# ==============================================================================
# GitHub Secrets Template for Git Mate (Keep this file local and private)
# Add these at: https://github.com/artemsvit/Gitler/settings/secrets/actions
# ==============================================================================

# 1. Apple Developer Account Email
APPLE_ID=your.apple.email@gmail.com

# 2. App-Specific Password from appleid.apple.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. 10-character Apple Developer Team ID from developer.apple.com
APPLE_TEAM_ID=XXXXXXXXXX

# 4. Base64 string of Developer ID Application.p12 (run: base64 -i cert.p12 | pbcopy)
APPLE_CERTIFICATE=PASTE_BASE64_STRING_HERE

# 5. Password for the exported .p12 certificate
APPLE_CERTIFICATE_PASSWORD=your_certificate_password
